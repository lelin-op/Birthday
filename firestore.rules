rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidSettingId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAppConfig(data) {
      return data.recipientName is string && data.recipientName.size() <= 200 &&
        data.letterTitle is string && data.letterTitle.size() <= 300 &&
        data.letterBody is string && data.letterBody.size() <= 10000 &&
        data.targetDateISO is string && data.targetDateISO.size() <= 100 &&
        data.theme in ['roseGold', 'blackPurplePink', 'midnightStar', 'lavenderDream', 'candlelight'] &&
        data.cakeStyle in [
          'butterflyPink', 'royalPurpleTwoTier', 'grandThreeTier', 'goldenLuxury',
          'strawberryVelvet', 'midnightGalaxy', 'matchaBlossom', 'chocolateFudge',
          'pastelRainbow', 'oceanBreeze', 'vintageCoquette', 'chocolatierGold', 'fairyGarden'
        ] &&
        data.soundEnabled is bool &&
        data.musicEnabled is bool &&
        (data.musicVolume is number || data.musicVolume is int) &&
        data.musicTrack in ['lofiBirthday', 'romanticPiano', 'acousticAura', 'youtube'] &&
        data.memories is list &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 200)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 800000)) &&
        (!('photoCaption' in data) || (data.photoCaption is string && data.photoCaption.size() <= 300)) &&
        (!('youtubeUrl' in data) || (data.youtubeUrl is string && data.youtubeUrl.size() <= 2000)) &&
        (!('musicLoop' in data) || (data.musicLoop is bool)) &&
        (!('musicStartOffset' in data) || (data.musicStartOffset is number || data.musicStartOffset is int)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /settings/{settingId} {
      allow read: if isValidSettingId(settingId);
      allow create, update: if isValidSettingId(settingId) && settingId == 'app_config' && isValidAppConfig(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
