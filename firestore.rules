rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidSettingId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAppConfig(data) {
      return data.recipientName is string && data.recipientName.size() <= 100 &&
        data.letterTitle is string && data.letterTitle.size() <= 200 &&
        data.letterBody is string && data.letterBody.size() <= 5000 &&
        data.targetDateISO is string && data.targetDateISO.size() <= 100 &&
        data.theme in ['roseGold', 'blackPurplePink', 'midnightStar', 'lavenderDream', 'candlelight'] &&
        data.cakeStyle in ['butterflyPink', 'royalPurpleTwoTier', 'grandThreeTier'] &&
        data.soundEnabled is bool &&
        data.musicEnabled is bool &&
        (data.musicVolume is number || data.musicVolume is int) &&
        data.musicTrack in ['lofiBirthday', 'romanticPiano', 'acousticAura'] &&
        data.memories is list &&
        (!('senderName' in data) || (data.senderName is string && data.senderName.size() <= 100)) &&
        (!('signatureName' in data) || (data.signatureName is string && data.signatureName.size() <= 100)) &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        (!('photoCaption' in data) || (data.photoCaption is string && data.photoCaption.size() <= 200)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    match /settings/{settingId} {
      allow read: if isValidSettingId(settingId);
      allow create, update: if isValidSettingId(settingId) && settingId == 'app_config' && isValidAppConfig(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

